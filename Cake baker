import os
import sqlite3
import requests
from flask import Flask, request, jsonify
from dotenv import load_dotenv
from google import genai
from google.genai import types

# Load environment variables
load_dotenv()

app = Flask(__name__)

# Configuration
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
WHATSAPP_TOKEN = os.getenv("WHATSAPP_TOKEN")
PHONE_NUMBER_ID = os.getenv("PHONE_NUMBER_ID")
VERIFY_TOKEN = os.getenv("VERIFY_TOKEN", "my_secret_token")
DB_NAME = "whatsapp_bot.db"

# Initialize Gemini Client
gemini_client = genai.Client(api_key=GEMINI_API_KEY)


# ==========================================
# DATABASE SETUP & HELPERS
# ==========================================
def init_db():
    """Initialize SQLite tables for orders and conversation history."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    # Orders table
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS orders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            phone_number TEXT NOT NULL,
            customer_name TEXT NOT NULL,
            items TEXT NOT NULL,
            delivery_address TEXT NOT NULL,
            total_price REAL NOT NULL,
            status TEXT DEFAULT 'Confirmed',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    # Chat history table for context persistence
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS chat_history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            phone_number TEXT NOT NULL,
            role TEXT NOT NULL,
            content TEXT NOT NULL,
            timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    conn.commit()
    conn.close()

def save_chat_message(phone_number, role, content):
    """Save a user or assistant message to SQLite."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO chat_history (phone_number, role, content) VALUES (?, ?, ?)",
        (phone_number, role, content)
    )
    conn.commit()
    conn.close()

def get_chat_history(phone_number, limit=10):
    """Retrieve recent conversation history for a given phone number."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute(
        "SELECT role, content FROM chat_history WHERE phone_number = ? ORDER BY id DESC LIMIT ?",
        (phone_number, limit)
    )
    rows = cursor.fetchall()
    conn.close()
    
    # Reconstruct chronological order for Gemini contents
    history = []
    for role, content in reversed(rows):
        history.append({"role": role, "parts": [{"text": content}]})
    return history


# ==========================================
# TOOL FUNCTION FOR GEMINI (ORDER CREATION)
# ==========================================
def save_order_to_db(phone_number: str, customer_name: str, items: str, delivery_address: str, total_price: float) -> str:
    """Saves a confirmed order directly into the SQLite database. Call this tool ONLY when the customer confirms 'YES'."""
    try:
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()
        cursor.execute(
            "INSERT INTO orders (phone_number, customer_name, items, delivery_address, total_price) VALUES (?, ?, ?, ?, ?)",
            (phone_number, customer_name, items, delivery_address, total_price)
        )
        conn.commit()
        order_id = cursor.lastrowid
        conn.close()
        return f"SUCCESS: Order #{order_id} recorded in database."
    except Exception as e:
        return f"ERROR: Failed to save order - {str(e)}"


# ==========================================
# GEMINI AI AGENT ENGINE
# ==========================================
SYSTEM_INSTRUCTION = """
You are an intelligent, friendly automated WhatsApp sales assistant for "Cake Hub".

BUSINESS DETAILS & CATALOG:
- Store Name: Cake Hub
- Products:
  * Custom Cakes: $25.00+
  * Cupcakes: $3.00 each / $30.00 per dozen
  * Pastries: $4.00 each
- Delivery: $5.00 local delivery flat fee. Pickup is free.
- Payment Options: Cash on Delivery or Mobile Transfer.

ORDER FLOW & GUIDELINES:
1. Answer customer queries politely and keep replies concise for WhatsApp.
2. To build an order, collect:
   a) Item name & quantity
   b) Delivery option (Address or Pickup)
   c) Customer full name
3. Before finalizing, display an Order Summary with the calculated total. Ask: "Please reply YES to confirm your order."
4. ONLY when the customer explicitly agrees or says "YES", invoke the `save_order_to_db` tool function.
"""

def process_user_message(phone_number, user_text):
    """Processes user input through Gemini, executes tools if needed, and returns the final text response."""
    # 1. Save user input to history
    save_chat_message(phone_number, "user", user_text)
    
    # 2. Build conversation context
    history = get_chat_history(phone_number, limit=12)

    # 3. Call Gemini API
    config = types.GenerateContentConfig(
        system_instruction=SYSTEM_INSTRUCTION,
        temperature=0.2,
        tools=[save_order_to_db]  # Pass function directly for tool calling
    )

    response = gemini_client.models.generate_content(
        model="gemini-2.5-flash",
        contents=history,
        config=config
    )

    # 4. Handle tool execution if Gemini decides to save an order
    final_reply = ""
    if response.function_calls:
        for function_call in response.function_calls:
            if function_call.name == "save_order_to_db":
                args = function_call.args
                # Inject user phone number if missing
                tool_result = save_order_to_db(
                    phone_number=phone_number,
                    customer_name=args.get("customer_name", "Valued Customer"),
                    items=args.get("items", "Unspecified items"),
                    delivery_address=args.get("delivery_address", "Pickup/Unspecified"),
                    total_price=float(args.get("total_price", 0.0))
                )
                final_reply = "Thank you! Your order has been placed and saved to our system. We will contact you soon for dispatch."
    else:
        final_reply = response.text

    # 5. Save assistant reply to history
    save_chat_message(phone_number, "model", final_reply)
    return final_reply


# ==========================================
# WHATSAPP API & FLASK ENDPOINTS
# ==========================================
def send_whatsapp_message(to_number, message_text):
    """Sends a text message back to WhatsApp via Meta's Graph API."""
    url = f"https://graph.facebook.com/v18.0/{PHONE_NUMBER_ID}/messages"
    headers = {
        "Authorization": f"Bearer {WHATSAPP_TOKEN}",
        "Content-Type": "application/json"
    }
    payload = {
        "messaging_product": "whatsapp",
        "to": to_number,
        "type": "text",
        "text": {"body": message_text}
    }
    response = requests.post(url, json=payload, headers=headers)
    return response.json()

@app.route("/webhook", methods=["GET"])
def verify_webhook():
    """Meta Webhook verification endpoint."""
    mode = request.args.get("hub.mode")
    token = request.args.get("hub.verify_token")
    challenge = request.args.get("hub.challenge")

    if mode == "subscribe" and token == VERIFY_TOKEN:
        return challenge, 200
    return "Forbidden", 403

@app.route("/webhook", methods=["POST"])
def receive_webhook():
    """Handles incoming messages from Meta WhatsApp API."""
    data = request.get_json()

    try:
        if "entry" in data:
            for entry in data["entry"]:
                for change in entry.get("changes", []):
                    value = change.get("value", {})
                    messages = value.get("messages", [])
                    
                    for msg in messages:
                        if msg.get("type") == "text":
                            from_number = msg["from"]
                            user_text = msg["text"]["body"]

                            # Process message and generate reply
                            ai_reply = process_user_message(from_number, user_text)
                            
                            # Send response via WhatsApp API
                            send_whatsapp_message(from_number, ai_reply)

    except Exception as e:
        print(f"Webhook processing error: {e}")

    return jsonify({"status": "ok"}), 200

@app.route("/orders", methods=["GET"])
def view_orders():
    """Utility endpoint to quickly view saved orders in JSON format."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM orders ORDER BY created_at DESC")
    columns = [column[0] for column in cursor.description]
    orders = [dict(zip(columns, row)) for row in cursor.fetchall()]
    conn.close()
    return jsonify(orders), 200


# ==========================================
# SERVER INITIALIZATION
# ==========================================
if __name__ == "__main__":
    init_db()
    print("Database initialized. Starting Flask server...")
    app.run(host="0.0.0.0", port=5000, debug=True)
