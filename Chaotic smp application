<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chaotics SMP Application</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #121212;
      color: #ffffff;
      display: flex;
      justify-content: center;
      padding: 20px;
    }
    .container {
      background-color: #1e1e1e;
      padding: 30px;
      border-radius: 10px;
      max-width: 500px;
      width: 100%;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }
    h1 { text-align: center; color: #ff4757; margin-bottom: 5px; }
    p.subtitle { text-align: center; color: #aaa; margin-bottom: 20px; }
    
    .rules {
      background-color: #2a2a2a;
      border-left: 4px solid #ff4757;
      padding: 12px;
      margin-bottom: 20px;
      font-size: 14px;
    }
    .rules h3 { margin-top: 0; color: #ff6b81; }
    .rules ul { margin: 5px 0 0 20px; padding: 0; }

    label { display: block; margin-top: 15px; font-weight: bold; }
    input, select, textarea {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      border-radius: 5px;
      border: 1px solid #444;
      background-color: #2b2b2b;
      color: #fff;
      box-sizing: border-box;
    }
    button {
      width: 100%;
      background-color: #2ed573;
      color: white;
      border: none;
      padding: 12px;
      margin-top: 25px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 5px;
      cursor: pointer;
    }
    button:hover { background-color: #26af5f; }
  </style>
</head>
<body>

<div class="container">
  <h1>Chaotics SMP</h1>
  <p class="subtitle">Official Server Application</p>

  <div class="rules">
    <h3>Server Rules</h3>
    <ul>
      <li>No spamming</li>
      <li>No bad language or swearing</li>
      <li>No abusive behavior</li>
    </ul>
  </div>

  <form id="smpForm">
    <label for="name">Full Name</label>
    <input type="text" id="name" required>

    <label for="mcUsername">Minecraft Username</label>
    <input type="text" id="mcUsername" required>

    <label for="age">Age</label>
    <input type="number" id="age" required>

    <label for="country">Country</label>
    <input type="text" id="country" required>

    <label for="email">Email</label>
    <input type="email" id="email" required>

    <label for="phone">Phone Number (Optional)</label>
    <input type="tel" id="phone">

    <label for="timezone">Timezone</label>
    <input type="text" id="timezone" placeholder="e.g., GMT+5 or EST" required>

    <label for="playTime">How long have you been playing Minecraft?</label>
    <input type="text" id="playTime" placeholder="e.g., 3 years" required>

    <button type="button" onclick="sendToWhatsApp()">Submit Application</button>
  </form>
</div>

<script>
  function sendToWhatsApp() {
    // REPLACE THIS WITH YOUR PHONE NUMBER IN INTERNATIONAL FORMAT (e.g., 14155552671)
    const adminPhoneNumber = "YOUR_PHONE_NUMBER_HERE";

    const name = document.getElementById('name').value;
    const mcUsername = document.getElementById('mcUsername').value;
    const age = document.getElementById('age').value;
    const country = document.getElementById('country').value;
    const email = document.getElementById('email').value;
    const phone = document.getElementById('phone').value || "Not provided";
    const timezone = document.getElementById('timezone').value;
    const playTime = document.getElementById('playTime').value;

    if (!name || !mcUsername || !age || !country || !email || !timezone || !playTime) {
      alert("Please fill in all required fields.");
      return;
    }

    const message = `*Chaotics SMP Application*%0A%0A` +
      `*Name:* ${name}%0A` +
      `*MC Username:* ${mcUsername}%0A` +
      `*Age:* ${age}%0A` +
      `*Country:* ${country}%0A` +
      `*Email:* ${email}%0A` +
      `*Phone:* ${phone}%0A` +
      `*Timezone:* ${timezone}%0A` +
      `*Play Time:* ${playTime}`;

    const whatsappUrl = `https://wa.me/${adminPhoneNumber}?text=${message}`;
    window.open(whatsappUrl, '_blank');
  }
</script>

</body>
</html>
